{
  "preset": "ts-jest/presets/default-esm",
  "testEnvironment": "node",
  "rootDir": ".",
  "testRegex": ".e2e-spec.ts$",
  "extensionsToTreatAsEsm": [".ts"],
  "moduleNameMapper": {
    "^firebase-admin/app$": "<rootDir>/mocks/firebase-admin-mock.js",
    "^firebase-admin/auth$": "<rootDir>/mocks/firebase-admin-mock.js",
    "^firebase-admin$": "<rootDir>/mocks/firebase-admin-mock.js",
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "transform": {
    "^.+\\.tsx?$": [
      "ts-jest",
      {
        "useESM": true,
        "diagnostics": {
          "ignoreCodes": [151002]
        },
        "tsconfig": {
          "target": "ES2022",
          "module": "NodeNext",
          "moduleResolution": "NodeNext",
          "esModuleInterop": true
        }
      }
    ]
  },
  "transformIgnorePatterns": [
    "node_modules/(?!(@nestjs|jose)/)"
  ]
}
