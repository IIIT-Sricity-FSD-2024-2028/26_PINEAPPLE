// Promotion plan definitions
const PROMOTION_PLANS = [
  {
    id: "plan-basic", name: "Basic Promotion", price: 2999,
    duration: "7 days", features: ["Standard visibility", "Search results listing", "Email to ~500 students"],
    visibilityBoost: "Standard"
  },
