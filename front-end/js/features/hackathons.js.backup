    id: "plan-featured", name: "Featured Hackathon", price: 7999,
    duration: "14 days", features: ["Featured on homepage banner", "Priority in search", "Email to ~2000 students", "Social media promotion"],
    visibilityBoost: "High"
  },
  {
    id: "plan-premium", name: "Premium Promotion", price: 14999,
    duration: "30 days", features: ["Homepage featured banner", "All filters priority", "Email to ~5000+ students", "Social media + webinar", "1-on-1 support", "Custom branding"],
    visibilityBoost: "Maximum"
  },
];

const HACK_STATE = {
  tab: "browse",
  searchQuery: "",
  filterMode: "all", // all, online, offline, hybrid
  filterDate: "all", // all, upcoming, ongoing
  filterDifficulty: "all", // all, beginner, intermediate
  hostStep: 1,
  showDetailModal: false,
  selectedHackathonId: null,
  useLocalData: true, // Use demo data when backend isn't available
};

function hackSetTab(tab) {
  HACK_STATE.tab = tab;
  renderHackathons();
}

async function renderHackathons() {
  const root = document.getElementById("hackathons-content");
  if (!root) return;

  const isAdmin =
    (typeof isSuperUser === "function" && isSuperUser()) ||
    ["administrator", "admin", "super user", "superuser"].includes(String(getCurrentUserRole()).toLowerCase());

  // Add admin revenue tab if user is super admin
  const adminTab = isAdmin ? `<button class="tab ${HACK_STATE.tab === "organizer-dashboard" ? "active" : ""}" onclick="hackSetTab('organizer-dashboard')">💰 Organizer Dashboard</button>` : '';

  root.innerHTML = `
    <div class="tabs" style="margin-bottom:20px">
      <button class="tab ${HACK_STATE.tab === "browse" ? "active" : ""}" onclick="hackSetTab('browse')">🔍 Discover</button>
      <button class="tab ${HACK_STATE.tab === "mine" ? "active" : ""}" onclick="hackSetTab('mine')">👥 My Hackathons</button>
      <button class="tab ${HACK_STATE.tab === "host" ? "active" : ""}" onclick="hackSetTab('host')">🏢 Host</button>
      ${adminTab}
    </div>
    <div id="hack-tab-body">Loading…</div>
  `;

  try {
    switch (HACK_STATE.tab) {
      case "browse":
        await hackRenderBrowse();
        break;
      case "mine":
        await hackRenderMine();
        break;
      case "host":
        await hackRenderHost();
        break;
      case "organizer-dashboard":
        await hackRenderOrganizerDashboard();
        break;
      default:
        await hackRenderBrowse();
        break;
    }
  } catch (err) {
    const body = document.getElementById("hack-tab-body");
    if (body) body.innerHTML = `<p style="color:var(--destructive)">Failed to load: ${hackEscapeHtml(err.message || String(err))}</p>`;
  }
}

function hackCard(innerHtml) {
  return `<div class="card mt-3" style="padding:16px">${innerHtml}</div>`;
}

// ════════════════════════════════════════════════════════════════
// BROWSE TAB: Discovery with search, filters, and revenue model
// ════════════════════════════════════════════════════════════════

async function hackRenderBrowse() {
  const body = document.getElementById("hack-tab-body");
  
  // Try to fetch from backend, fall back to demo data
  let hackathons = [];
  try {
    hackathons = await hackathonsApi.search(HACK_STATE.searchQuery);
  } catch (err) {
    hackathons = [...DEMO_HACKATHONS];
  }
  
  // Filter hackathons based on filters
  hackathons = hackathons.filter(h => {
    const matchesSearch = !HACK_STATE.searchQuery || 
      h.name.toLowerCase().includes(HACK_STATE.searchQuery.toLowerCase()) ||
      h.description.toLowerCase().includes(HACK_STATE.searchQuery.toLowerCase()) ||
      (h.theme && h.theme.toLowerCase().includes(HACK_STATE.searchQuery.toLowerCase()));
    
    const matchesMode = HACK_STATE.filterMode === "all" || h.mode.toLowerCase() === HACK_STATE.filterMode.toLowerCase();
    
    const matchesDate = HACK_STATE.filterDate === "all" || 
      (HACK_STATE.filterDate === "upcoming" && h.status === "RegistrationOpen") ||
      (HACK_STATE.filterDate === "ongoing" && h.status === "Ongoing");
    
    return matchesSearch && matchesMode && matchesDate;
  });
  
  // Sort: sponsored first, then featured, then by date
  hackathons.sort((a, b) => {
    if (a.sponsored !== b.sponsored) return a.sponsored ? -1 : 1;
    if (a.featured !== b.featured) return a.featured ? -1 : 1;
    return new Date(b.regDeadline) - new Date(a.regDeadline);
  });

  body.innerHTML = `
    <div style="background:var(--secondary);padding:20px;border-radius:8px;margin-bottom:20px">
      <h2 style="margin-top:0;margin-bottom:4px">🏆 Discover Hackathons</h2>
      <p class="page-subtitle" style="margin:0;margin-bottom:16px">Find hackathons, build teams, and turn ideas into projects.</p>
      
      <div style="display:flex;gap:10px;margin-bottom:12px;flex-wrap:wrap;align-items:center">
        <input class="input" id="hack-search-input" placeholder="Search by name, theme, or technology…"
          value="${hackEscapeHtml(HACK_STATE.searchQuery)}" style="flex:1;min-width:200px" onkeydown="if(event.key==='Enter') hackDoSearch()">
        <button class="btn btn-primary" onclick="hackDoSearch()">Search</button>
      </div>

      <div style="display:flex;gap:8px;flex-wrap:wrap">
        <select class="input" id="hack-filter-mode" style="flex:1;min-width:120px" onchange="hackSetFilterMode(this.value)">
          <option value="all">📍 All Modes</option>
          <option value="online">🌐 Online</option>
          <option value="offline">🏢 Offline</option>
          <option value="hybrid">🔄 Hybrid</option>
        </select>
        
        <select class="input" id="hack-filter-date" style="flex:1;min-width:120px" onchange="hackSetFilterDate(this.value)">
          <option value="all">📅 All Dates</option>
          <option value="upcoming">⏰ Upcoming</option>
          <option value="ongoing">▶️ Ongoing</option>
        </select>

        <button class="btn btn-outline" onclick="hackClearFilters()" style="flex:0">Clear Filters</button>
      </div>
    </div>

    <div id="hack-featured-section" style="margin-bottom:24px"></div>

    <div id="hack-browse-list">
      ${
        hackathons.length === 0
          ? `<div class="card" style="padding:40px;text-align:center"><p class="page-subtitle">No hackathons match your filters. Try adjusting your search.</p></div>`
          : hackathons
              .map((h) => hackRenderHackathonCard(h))
              .join("")
      }
    </div>

    <div style="margin-top:32px;padding:16px;background:var(--secondary);border-radius:8px">
      <h4 style="margin-top:0">💼 For Organizers</h4>
      <p class="page-subtitle">Want to host a hackathon? TeamForge helps you reach thousands of students. <strong>Featured hackathons get 3x more registrations.</strong></p>
      <button class="btn btn-primary" onclick="hackSetTab('host')">Start Hosting →</button>
    </div>
  `;
  
  // Update filter select values
  document.getElementById("hack-filter-mode").value = HACK_STATE.filterMode;
  document.getElementById("hack-filter-date").value = HACK_STATE.filterDate;
  
  // Render featured section if there are sponsored hackathons
  const sponsored = hackathons.filter(h => h.sponsored);
  if (sponsored.length > 0) {
    const featuredHtml = `
      <div style="background:linear-gradient(135deg, #667eea 0%, #764ba2 100%);padding:24px;border-radius:8px;color:white;margin-bottom:20px">
        <h3 style="margin-top:0;color:white">⭐ Featured & Sponsored Hackathons</h3>
        <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(300px, 1fr));gap:16px">
          ${sponsored.map(h => hackRenderFeaturedCard(h)).join("")}
        </div>
      </div>
    `;
    document.getElementById("hack-featured-section").innerHTML = featuredHtml;
  }
}

function hackRenderHackathonCard(h) {
  const statusColor = h.status === "RegistrationOpen" ? "var(--success)" : h.status === "Ongoing" ? "var(--primary)" : "var(--muted-fg)";
  const statusIcon = h.status === "RegistrationOpen" ? "🟢" : h.status === "Ongoing" ? "▶️" : "⏸️";
  
  let badges = '';
  if (h.sponsored) badges += '<span class="badge" style="background:#fbbf24;color:#000;margin-right:6px">💰 Sponsored</span>';
  if (h.featured) badges += '<span class="badge" style="background:#06b6d4;color:#fff;margin-right:6px">⭐ Featured</span>';
  
  return `
    <div class="card" style="padding:16px;cursor:pointer;transition:box-shadow 0.2s" onmouseover="this.style.boxShadow='0 8px 16px rgba(0,0,0,0.1)'" onmouseout="this.style.boxShadow='none'" onclick="hackOpenDetail('${h.id}')">
      <div style="display:flex;justify-content:space-between;align-items:start;margin-bottom:12px">
        <div style="font-size:2rem">${h.logo || '🏆'}</div>
        <div style="text-align:right">${badges}</div>
      </div>
      <h4 style="margin:0;margin-bottom:6px">${hackEscapeHtml(h.name)}</h4>
      <p style="margin:0;font-size:0.85rem;color:var(--muted-fg);margin-bottom:8px">${hackEscapeHtml(h.organizer)}</p>
      <p style="margin:0;margin-bottom:12px;font-size:0.9rem">${hackEscapeHtml(h.description.substring(0, 100))}...</p>
      
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;font-size:0.85rem;margin-bottom:12px">
        <div>💰 ₹${(h.prizePool || 0).toLocaleString()}</div>
        <div>👥 ${h.teamSize}</div>
        <div>🌐 ${h.mode}</div>
        <div>${statusIcon} <span style="color:${statusColor}">${h.status.replace(/([A-Z])/g, ' $1').trim()}</span></div>
      </div>
      
      <div style="border-top:1px solid var(--border);padding-top:8px;font-size:0.8rem;color:var(--muted-fg)">
        <span>📅 Register: ${h.regDeadline}</span> • <span>👁️ ${h.views || 0} views</span>
      </div>
    </div>
  `;
}

function hackRenderFeaturedCard(h) {
  return `
    <div style="background:rgba(255,255,255,0.1);padding:16px;border-radius:6px;cursor:pointer;border:2px solid rgba(255,255,255,0.3);transition:all 0.2s" onmouseover="this.style.background='rgba(255,255,255,0.2)'" onmouseout="this.style.background='rgba(255,255,255,0.1)'" onclick="hackOpenDetail('${h.id}')">
      <h4 style="margin:0;margin-bottom:8px">${hackEscapeHtml(h.name)}</h4>
      <p style="margin:0;margin-bottom:8px;font-size:0.9rem">🏆 ₹${(h.prizePool || 0).toLocaleString()}</p>
      <p style="margin:0;margin-bottom:12px;font-size:0.85rem;opacity:0.9">${hackEscapeHtml(h.organizer)}</p>
      <button style="background:white;color:#667eea;border:none;padding:6px 12px;border-radius:4px;font-weight:600;cursor:pointer" onclick="hackOpenDetail('${h.id}'); return false">View Details →</button>
    </div>
  `;
}

function hackDoSearch() {
  HACK_STATE.searchQuery = document.getElementById("hack-search-input")?.value.trim() || "";
  hackRenderBrowse();
}

function hackSetFilterMode(mode) {
  HACK_STATE.filterMode = mode;
  hackRenderBrowse();
}

function hackSetFilterDate(date) {
  HACK_STATE.filterDate = date;
  hackRenderBrowse();
}

function hackClearFilters() {
  HACK_STATE.searchQuery = "";
  HACK_STATE.filterMode = "all";
  HACK_STATE.filterDate = "all";
  hackRenderBrowse();
}

// ════════════════════════════════════════════════════════════════
// DETAIL PAGE: Full hackathon information with action buttons
// ════════════════════════════════════════════════════════════════

async function hackOpenDetail(hackathonId) {
  const body = document.getElementById("hack-tab-body");
  
  // Try to fetch from backend, fall back to demo data
  let h = DEMO_HACKATHONS.find(x => x.id === hackathonId);
  if (!h) {
    try {
      h = await hackathonsApi.get(hackathonId);
    } catch (err) {
      showToast("Hackathon not found", "error");
      return;
    }
  }

  body.innerHTML = `
    <button class="btn btn-outline btn-sm" onclick="hackRenderBrowse()" style="margin-bottom:16px">&larr; Back to Browse</button>
    
    ${hackCard(`
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;align-items:start">
        <div>
          <div style="font-size:3rem;margin-bottom:12px">${h.logo || '🏆'}</div>
          <h1 style="margin:0;margin-bottom:4px">${hackEscapeHtml(h.name)}</h1>
          <p style="margin:0;margin-bottom:16px;color:var(--muted-fg);font-size:1.1rem">${hackEscapeHtml(h.organizer)}</p>
          
          <div style="display:flex;gap:8px;margin-bottom:16px;flex-wrap:wrap">
            ${h.sponsored ? '<span class="badge" style="background:#fbbf24;color:#000">💰 Sponsored</span>' : ''}
            ${h.featured ? '<span class="badge" style="background:#06b6d4;color:#fff">⭐ Featured</span>' : ''}
            <span class="badge">${h.status.replace(/([A-Z])/g, ' $1').trim()}</span>
          </div>
          
          <p style="font-size:1.05rem;line-height:1.6">${hackEscapeHtml(h.description)}</p>
        </div>
        
        <div style="background:var(--secondary);padding:20px;border-radius:8px">
          <h3 style="margin-top:0">Quick Info</h3>
          <div style="display:flex;flex-direction:column;gap:12px;font-size:0.95rem">
            <div><strong>🏆 Prize Pool</strong><br>₹${(h.prizePool || 0).toLocaleString()}</div>
            <div><strong>👥 Team Size</strong><br>${h.teamSize} members</div>
            <div><strong>🌐 Mode</strong><br>${h.mode}${h.location ? ` • ${h.location}` : ''}</div>
            <div><strong>📅 Registration Deadline</strong><br>${h.regDeadline}</div>
            <div><strong>📍 Event Date</strong><br>${h.eventDate}</div>
            <div><strong>🎯 Eligibility</strong><br>${h.eligibility}</div>
          </div>
          
          ${h.status === "RegistrationOpen" || h.status === "Ongoing" ? `
            <button class="btn btn-primary" style="width:100%;margin-top:16px" onclick="hackShowTeamForm('${h.id}')">📝 Register / Join Team</button>
          ` : `
            <p class="page-subtitle" style="margin-top:16px">Registration is currently closed.</p>
          `}
        </div>
      </div>
    `)}
    
    ${hackCard(`
      <h3 style="margin-top:0">📋 Overview</h3>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px">
        <div>
          <h4 style="margin-top:0;color:var(--primary)">Theme & Technologies</h4>
          <p>${h.theme ? hackEscapeHtml(h.theme) : 'Not specified'}</p>
          ${h.technologies ? `<div style="display:flex;gap:6px;flex-wrap:wrap">${h.technologies.map(t => `<span class="badge" style="background:var(--primary);color:#fff">${hackEscapeHtml(t)}</span>`).join('')}</div>` : ''}
        </div>
        <div>
          <h4 style="margin-top:0;color:var(--success)">Participation Metrics</h4>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;font-size:0.9rem">
            <div>👁️ <strong>${(h.views || 0).toLocaleString()}</strong> views</div>
            <div>📝 <strong>${(h.registrations || 0).toLocaleString()}</strong> registrations</div>
            <div>👥 <strong>${(h.teamMatches || 0).toLocaleString()}</strong> team matches</div>
          </div>
        </div>
      </div>
    `)}
    
    ${hackCard(`
      <h3 style="margin-top:0">🏅 Prize Distribution</h3>
      <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px">
        <div style="background:var(--secondary);padding:16px;border-radius:6px;text-align:center">
          <div style="font-size:1.8rem">🥇</div>
          <div style="font-weight:600;color:var(--gold)">1st Prize</div>
          <div style="font-size:1.2rem;margin-top:8px">₹${Math.round((h.prizePool || 0) * 0.5).toLocaleString()}</div>
        </div>
        <div style="background:var(--secondary);padding:16px;border-radius:6px;text-align:center">
          <div style="font-size:1.8rem">🥈</div>
          <div style="font-weight:600;color:var(--silver)">2nd Prize</div>
          <div style="font-size:1.2rem;margin-top:8px">₹${Math.round((h.prizePool || 0) * 0.3).toLocaleString()}</div>
        </div>
        <div style="background:var(--secondary);padding:16px;border-radius:6px;text-align:center">
          <div style="font-size:1.8rem">🥉</div>
          <div style="font-weight:600;color:var(--bronze)">3rd Prize</div>
          <div style="font-size:1.2rem;margin-top:8px">₹${Math.round((h.prizePool || 0) * 0.2).toLocaleString()}</div>
        </div>
      </div>
    `)}
    
    ${hackCard(`
      <h3 style="margin-top:0">🤝 Find Your Team</h3>
      <p class="page-subtitle">Join or create a team and connect with the right teammates.</p>
      <button class="btn btn-primary" onclick="hackShowFindTeammates('${h.id}')">🔍 Find Teammates for This Hackathon</button>
      <button class="btn btn-outline" style="margin-left:8px" onclick="hackShowCreateTeam('${h.id}')">✨ Create New Team</button>
    `)}
    
    ${hackCard(`
      <h3 style="margin-top:0">📞 Contact Organizer</h3>
      <p class="page-subtitle">Have questions? Get in touch with ${hackEscapeHtml(h.organizer)}.</p>
      <p style="margin:12px 0"><strong>Email:</strong> hackathon@${h.organizer.toLowerCase().replace(/\\s+/g, '')} .com</p>
      <button class="btn btn-outline">Contact Organizer</button>
    `)}
  `;
}

