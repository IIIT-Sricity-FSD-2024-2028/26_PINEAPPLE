# Authentication Mode: "jwt" (default), "firebase", or "legacy"
VITE_AUTH_MODE=jwt

# API Base URL
VITE_API_BASE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# Firebase Configuration (used when VITE_AUTH_MODE=firebase)
# ─────────────────────────────────────────────────────────────
# Use local Firebase emulator (http://localhost:9099) by default
VITE_USE_AUTH_EMULATOR=true
VITE_FIREBASE_AUTH_EMULATOR_URL=http://localhost:9099

# Standard Firebase Client Config (placeholders for real Firebase or emulator)
VITE_FIREBASE_API_KEY=AIzaSyDemoKeyForTeamForgeDev123456
VITE_FIREBASE_AUTH_DOMAIN=teamforge-demo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=teamforge-demo
VITE_FIREBASE_STORAGE_BUCKET=teamforge-demo.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
