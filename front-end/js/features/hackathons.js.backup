// ══════════════════════════════════════════════════════════════
//  hackathons.js — 🏆 Hackathons Discovery & Revenue Model
//
//  Tabs: Browse (search + list + filters), My Hackathons (teams/invites/workspace),
//  Host (create + manage + revenue), Organizer Dashboard (analytics + promotion plans).
//  
//  Revenue Model:
//  - Sponsored Hackathons: Featured placement (₹2,999-₹14,999)
//  - Premium Organizer Listing: Custom branding + analytics
//  - Recruiter Access: Talent discovery from hackathon teams
//
//  Talks to hackathons/, teams/, team-invitations/, hackathon-registrations/,
//  organizations/, payouts/, and promotions/ backend modules via apiClient.js.
// ══════════════════════════════════════════════════════════════

function hackEscapeHtml(value) {
  return String(value ?? "").replace(/[&<>"']/g, (c) => ({
    "&": "&amp;",
    "<": "&lt;",
    ">": "&gt;",
    '"': "&quot;",
    "'": "&#39;",
  })[c]);
}

