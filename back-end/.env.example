# Server Port and Origins
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Authentication Mode: "jwt" (default), "firebase", or "legacy"
AUTH_MODE=jwt

# ─────────────────────────────────────────────────────────────
# JWT Authentication Configuration (AUTH_MODE=jwt)
# ─────────────────────────────────────────────────────────────
# Secret used to sign and verify HS256 access tokens (minimum 32 characters in production)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ─────────────────────────────────────────────────────────────
# Firebase Authentication Configuration (AUTH_MODE=firebase)
# ─────────────────────────────────────────────────────────────
# Project ID for Firebase
FIREBASE_PROJECT_ID=teamforge-demo

# When running offline with Firebase Local Emulator Suite (recommended):
# Point this to the local Auth emulator host (e.g. localhost:9099)
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# When using a real Firebase project in cloud mode:
# Path to service account JSON (never commit the actual JSON file!)
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# ─────────────────────────────────────────────────────────────
# Payment & Escrow Configuration (Mentor Marketplace)
# ─────────────────────────────────────────────────────────────
# Payment gateway provider: "demo_upi" (default) or "razorpay" / "stripe"
PAYMENT_GATEWAY_PROVIDER=demo_upi
DEMO_UPI_VPA=teamforge@demo
PAYMENT_HOLD_MINUTES=10

# ─────────────────────────────────────────────────────────────
# DigiLocker Credential Verification Configuration
# ─────────────────────────────────────────────────────────────
# DigiLocker mode: "sandbox" (default simulated mock) or "real" (production OAuth2)
DIGILOCKER_MODE=sandbox
DIGILOCKER_CLIENT_ID=demo_digilocker_client_id
DIGILOCKER_CLIENT_SECRET=demo_digilocker_client_secret
DIGILOCKER_REDIRECT_URI=http://localhost:3000/mentor-applications/digilocker/callback

# ─────────────────────────────────────────────────────────────
# Mail Delivery Configuration (Password Reset & Notifications)
# ─────────────────────────────────────────────────────────────
# Mail provider mode: "ethereal" (default dev inbox), "smtp" (real email), or "console" (dev stdout)
MAIL_MODE=ethereal
FRONTEND_URL=http://localhost:5173
MAIL_FROM="TeamForge <no-reply@teamforge.io>"

# SMTP Credentials (required when MAIL_MODE=smtp)
# For Gmail: use smtp.gmail.com, port 465 (secure=true) or 587 (secure=false), and a 16-character App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password

# Startup Storage Cleanup (erases non-seed uploads/CVs/exports on boot)
CLEAN_UPLOADS_ON_START=true

# Upload Storage Root (kept outside watched source directories so dev servers never restart)
UPLOAD_DIR=./.runtime/uploads
